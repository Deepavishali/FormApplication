@model IEnumerable<DatabaseMigration.Models.User>

@{
    ViewData["Title"] = "User List";
}

<h2>All Registered User</h2>

<div class="container-fluid mt-4 px-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-dark fw-bold">User Directory</h2>
            <p class="text-muted small mb-0">Manage all system user accounts and detailed migrations.</p>
        </div>
        <span class="badge bg-primary px-3 py-2 fs-6 shadow-sm">Total Records: @Model.Count()</span>
    </div>

    @* Search Form by ID *@

    <form asp-action="Read" method="get" class="row g-3 mb-4">
        <div class="col-auto">
            <input type="text" name="searchId" class="form-control" placeholder="Enter user ID"/>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search by Id</button>
        </div>
        <div class="col-auto">
            <a asp-action="Read" class="btn btn-secondary">Reset</a>
        </div>
    </form>

    <div class="table-responsive shadow border rounded bg-white">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th scope="col" class="ps-3" style="width: 70px;">ID</th>
                    <th scope="col">Full Name</th>
                    <th scope="col">Contact Info</th>
                    <th scope="col">Demographics</th>
                    <th scope="col">Full Address</th>
                    <th scope="col" class="text-center">Status</th>
                    <th scope="col">Joined Date</th>
                    <th scope="col" class="text-center" style="width: 200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5">
                            <p class="fs-5 mb-1 fw-semibold">No user records found</p>
                            <span class="small text-secondary">The database current contains zero user objects.</span>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <!-- ID -->
                            <td class="ps-3 fw-bold text-secondary">@user.Id</td>

                            <!-- Name -->
                            <td class="fw-semibold text-dark">@(user.Name ?? "N/A")</td>

                            <!-- Contact Info -->
                            <td>
                                <div class="small fw-semibold">
                                    <a href="mailto:@user.Email" class="text-decoration-none">@user.Email</a>
                                </div>
                                <div class="text-muted small text-nowrap">
                                    <span class="text-secondary">Mob:</span> @(user.Mobile ?? "N/A")
                                </div>
                            </td>

                            <!-- Demographics -->
                            <td>
                                <div class="small">
                                    <span class="text-secondary fw-semibold">DOB:</span>
                                    @(user.DateOfBirth.HasValue ? user.DateOfBirth.Value.ToString("dd-MMM-yyyy") : "N/A")
                                </div>
                                <div class="small">
                                    <span class="text-secondary fw-semibold">Gender:</span> @(user.Gender ?? "N/A")
                                </div>
                            </td>

                            <!-- Full Address -->
                            <td class="small text-wrap" style="max-width: 250px;">
                                @if (!string.IsNullOrEmpty(user.Address))
                                {
                                    <span>@user.Address, </span>
                                }
                                <span class="text-muted">
                                    @user.City@(!string.IsNullOrEmpty(user.State) ? $", {user.State}" : "")@(!string.IsNullOrEmpty(user.PostalCode) ? $" - {user.PostalCode}" : "")
                                </span>
                                @if (string.IsNullOrEmpty(user.Address) && string.IsNullOrEmpty(user.City))
                                {
                                    <span class="text-muted italic">No address provided</span>
                                }
                            </td>

                            <!-- Status -->
                            <td class="text-center">
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success px-2 py-1 small rounded-pill">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1 small rounded-pill">Inactive</span>
                                }
                            </td>

                            <!-- Joined Date -->
                            <td class="small text-muted">
                                @user.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </td>

                            <!-- Actions -->
                            <td class="text-center pe-3">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Edit Profile">
                                        Edit
                                    </a>
                                   
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-outline-danger" title="Remove User">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>